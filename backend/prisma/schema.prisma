datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── Platform ────────────────────────────────────────────────────────────────
enum NodeStatus {
  setup
  active
  paused
  closed
}

enum ActorType {
  user
  customer
  system
}

// ─── Mission layer ───────────────────────────────────────────────────────────
enum MissionPhase {
  setup
  foundation
  activation
  scale
}

enum MissionScope {
  food
  art
  lifestyle
  system
  mixed
}

enum MissionStatus {
  planned
  active
  completed
  paused
}

enum QuestStatus {
  planned
  active
  completed
  blocked
}

enum TaskStatus {
  todo
  doing
  done
  blocked
  cancelled
}

enum TaskType {
  core
  adhoc
  improvement
}

enum TaskDomain {
  food
  art
  lifestyle
  ops
  procurement
  bi
  talent
  tech
  design
}

enum TaskPriority {
  low
  medium
  high
  critical
}

enum TaskSubjectType {
  recipe
  product
  event
  vendor
  purchase_order
  prep_batch
  order
  decision
}

enum EvidenceType {
  image
  document
  video
  link
  note
  system
}

enum EvidenceSource {
  manual
  bridge
}

enum ApprovalStatus {
  pending
  approved
  rejected
}

enum ApprovalEntityType {
  task
  evidence
  decision
  recipe
}

enum ApprovalScope {
  task
  decision
  recipe
  pricing
  vendor
  experience
  tech
  hiring
  review
}

enum ApprovalMode {
  all
  n_of
}

enum DecisionStatus {
  proposed
  aligned
  approved
  rejected
  reopened
}

enum GovernanceTier {
  tier_1
  tier_2
  tier_3
}

enum VoteValue {
  approve
  reject
  abstain
}

enum MeterMode {
  task_driven
  derived
  hybrid
}

// ─── Catalog ─────────────────────────────────────────────────────────────────
enum ProductType {
  prepared_food
  packaged
  experience
  merchandise
}

enum FulfilmentType {
  local
  shipped
  booking
}

enum StockMode {
  derived_from_recipe
  tracked
  capacity
}

enum ProductStatus {
  draft
  active
  archived
}

enum MediaKind {
  image
  video
}

// ─── Commerce ────────────────────────────────────────────────────────────────
enum OrderChannel {
  dine_in
  takeaway
  delivery
  marketplace
}

enum OrderStatus {
  placed
  confirmed
  preparing
  ready
  served
  dispatched
  shipped
  delivered
  completed
  cancelled
  refunded
}

enum OrderItemStatus {
  pending
  preparing
  ready
  packed
  shipped
  delivered
  attended
  cancelled
}

enum OrderSource {
  pos
  storefront
  webhook_fallback
}

enum DeliveryStatus {
  picked_up
  in_transit
  delivered
}

enum PaymentMethod {
  cash
  card
  upi
  razorpay
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
  partially_refunded
}

enum EventType {
  dining
  workshop
  pop_up
  tasting
  other
}

enum EventStatus {
  draft
  upcoming
  live
  past
  cancelled
}

enum BookingStatus {
  held
  confirmed
  cancelled
  attended
  no_show
}

// ─── Declared for P5 (no model uses them yet — SPEC §3.3) ────────────────────
enum ShippingProvider {
  shiprocket
  manual
}

enum ShipmentStatus {
  pending
  awb_assigned
  pickup_scheduled
  picked_up
  in_transit
  out_for_delivery
  delivered
  rto
  cancelled
  failed
}

enum CouponType {
  percent
  fixed
  free_shipping
}

enum LoyaltyTier {
  member
  regular
  insider
}

enum LoyaltyReason {
  earn
  redeem
  adjust
  expire
}

enum ReviewStatus {
  pending
  published
  hidden
}

// ─── Operations ──────────────────────────────────────────────────────────────
enum RecipeStatus {
  draft
  pending
  approved
  archived
}

enum PreparationType {
  scratch
  batch_prepared
  ready_to_sell
  assemble
}

enum UsageType {
  recipe_input
  supply
  equipment
}

enum MovementType {
  purchase_received
  prep_deducted
  order_deducted
  waste
  adjustment
  supply_usage
  import
  shipment_packed
  return
}

enum PurchaseOrderStatus {
  draft
  ordered
  received
  cancelled
}

enum PrepBatchStatus {
  active
  depleted
  expired
}

enum NotificationType {
  task_due
  task_blocked
  approval_pending
  low_stock
  new_order
  order_ready
  delivery_update
  admin_notice
}

enum NotificationChannel {
  in_app
  email
  whatsapp
}

model Role {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String
  permissions String[]
  created_at  DateTime @default(now())
  users       User[]
}

model User {
  id                   String                    @id @default(uuid())
  name                 String
  email                String                    @unique
  password_hash        String
  role_id              String
  role                 Role                      @relation(fields: [role_id], references: [id])
  function             String
  status               String                    @default("active")
  xp_total             Int                       @default(0)
  level                Int                       @default(1)
  streak_days          Int                       @default(0)
  created_at           DateTime                  @default(now())
  updated_at           DateTime                  @updatedAt
  refresh_tokens       RefreshToken[]
  reset_tokens         PasswordResetToken[]
  owned_tasks          Task[]                    @relation("TaskOwner")
  created_tasks        Task[]                    @relation("TaskCreator")
  updated_tasks        Task[]                    @relation("TaskUpdater")
  evidence             Evidence[]
  reviewed_evidence    Evidence[]                @relation("EvidenceReviewer")
  approved_approvals   Approval[]                @relation("ApprovalApprover")
  overridden_approvals Approval[]                @relation("ApprovalOverrider")
  delegated_approvals  Approval[]                @relation("ApprovalDelegate")
  proposed_decisions   Decision[]                @relation("DecisionProposer")
  decision_votes       DecisionVote[]            @relation("DecisionVoter")
  owned_quests         Quest[]
  owned_zones          Zone[]
  owned_brands         Brand[]
  created_assets       Asset[]
  delegations_from     ApprovalDelegation[]      @relation("DelegationFrom")
  delegations_to       ApprovalDelegation[]      @relation("DelegationTo")
  delegations_created  ApprovalDelegation[]      @relation("DelegationCreator")
  created_recipes      Recipe[]                  @relation("RecipeCreator")
  stockMovements       StockMovement[]           @relation("StockMovementCreator")
  purchaseOrders       PurchaseOrder[]           @relation("PurchaseOrderer")
  prepBatches          PrepBatch[]               @relation("PrepBatchCreator")
  wasteLogs            WasteLog[]                @relation("WasteLogCreator")
  orders               Order[]                   @relation("OrderCreator")
  notifications        Notification[]
  export_records       ExportRecord[]
  chat_participations  ConversationParticipant[]
  sent_messages        Message[]

  // Optimizes: leaderboard query (active users sorted by xp_total desc)
  @@index([status, xp_total(sort: Desc)])
  // Optimizes: role-based user lookups, auth queries
  @@index([role_id])
}

model RefreshToken {
  id         String    @id @default(uuid())
  user_id    String
  user       User      @relation(fields: [user_id], references: [id])
  token_hash String
  revoked_at DateTime?
  expires_at DateTime
  created_at DateTime  @default(now())

  @@index([user_id])
  @@index([token_hash])
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  user_id    String
  user       User      @relation(fields: [user_id], references: [id])
  token_hash String
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  @@index([token_hash])
}

model Mission {
  id               String        @id @default(uuid())
  title            String
  description      String
  phase            MissionPhase  @default(setup)
  scope            MissionScope  @default(food)
  status           MissionStatus @default(planned)
  start_date       DateTime?
  end_date         DateTime?
  progress_percent Float         @default(0)
  created_by       String
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt
  quests           Quest[]
  tasks            Task[]
  decisions        Decision[]    @relation("DecisionMission")
}

model Quest {
  id                     String      @id @default(uuid())
  mission_id             String
  mission                Mission     @relation(fields: [mission_id], references: [id])
  title                  String
  description            String
  week_number            Int
  owner_user_id          String
  owner                  User        @relation(fields: [owner_user_id], references: [id])
  status                 QuestStatus @default(planned)
  baseline_task_count    Int         @default(0)
  core_progress_percent  Float       @default(0)
  adhoc_progress_percent Float       @default(0)
  progress_percent       Float       @default(0)
  start_date             DateTime?
  end_date               DateTime?
  created_at             DateTime    @default(now())
  updated_at             DateTime    @updatedAt
  tasks                  Task[]
}

model Task {
  id                     String               @id @default(uuid())
  mission_id             String
  mission                Mission              @relation(fields: [mission_id], references: [id])
  quest_id               String?
  quest                  Quest?               @relation(fields: [quest_id], references: [id])
  title                  String
  description            String
  task_type              TaskType             @default(core)
  domain                 TaskDomain
  owner_user_id          String
  owner                  User                 @relation("TaskOwner", fields: [owner_user_id], references: [id])
  created_by             String
  creator                User                 @relation("TaskCreator", fields: [created_by], references: [id])
  updated_by             String?
  updater                User?                @relation("TaskUpdater", fields: [updated_by], references: [id])
  status                 TaskStatus           @default(todo)
  priority               TaskPriority         @default(medium)
  subject_type           TaskSubjectType?
  subject_id             String?
  xp                     Int                  @default(25)
  valid_xp               Int                  @default(0)
  verified               Boolean              @default(false)
  valid                  Boolean              @default(false)
  requires_approval      Boolean              @default(true)
  blocked                Boolean              @default(false)
  blocked_reason         String?
  depends_on_task_id     String?
  depends_on             Task?                @relation("TaskDependency", fields: [depends_on_task_id], references: [id])
  dependents             Task[]               @relation("TaskDependency")
  readiness_meter_id     String?
  readiness_meter        ReadinessMeter?      @relation(fields: [readiness_meter_id], references: [id])
  readiness_value        Int                  @default(0)
  kpi_id                 String?
  kpi                    Kpi?                 @relation(fields: [kpi_id], references: [id])
  due_date               DateTime?
  completed_at           DateTime?
  created_at             DateTime             @default(now())
  updated_at             DateTime             @updatedAt
  evidence               Evidence[]
  approvals              Approval[]           @relation("TaskApprovals")
  readiness_events       TaskReadinessEvent[]
  linked_assets          Asset[]
  linked_purchase_orders PurchaseOrder[]
  linked_decisions       Decision[]           @relation("DecisionTask")

  @@index([owner_user_id, status])
  @@index([quest_id, valid])
  @@index([mission_id])
  // Optimizes: notifications.cron scanTasksDue (due_date range + status filter)
  @@index([due_date, status])
  // Optimizes: analytics getWins (valid + completed_at cursor pagination)
  @@index([valid, completed_at(sort: Desc)])
  // Optimizes: bridge lookups of the tasks attached to a domain record
  @@index([subject_type, subject_id])
  // Optimizes: status-first board queries ordered by due date
  @@index([status, due_date])
}

model Evidence {
  id              String         @id @default(uuid())
  task_id         String
  task            Task           @relation(fields: [task_id], references: [id])
  uploaded_by     String
  uploader        User           @relation(fields: [uploaded_by], references: [id])
  type            EvidenceType
  source          EvidenceSource @default(manual)
  bridge_event    String?
  url             String
  notes           String?
  approval_status ApprovalStatus @default(pending)
  reviewed_by     String?
  reviewer        User?          @relation("EvidenceReviewer", fields: [reviewed_by], references: [id])
  reviewed_at     DateTime?
  created_at      DateTime       @default(now())

  // Optimizes: findByTask (evidence by task_id)
  @@index([task_id])
  // Optimizes: getFeed filtered by approval_status, ordered by created_at
  @@index([approval_status, created_at(sort: Desc)])
}

model Approval {
  id                     String             @id @default(uuid())
  entity_type            ApprovalEntityType
  entity_id              String
  task                   Task?              @relation("TaskApprovals", fields: [entity_id], references: [id])
  approval_scope         ApprovalScope
  required_role_code     String
  approved_by            String?
  approver               User?              @relation("ApprovalApprover", fields: [approved_by], references: [id])
  status                 ApprovalStatus     @default(pending)
  notes                  String?
  override_by            String?
  overrider              User?              @relation("ApprovalOverrider", fields: [override_by], references: [id])
  override_reason        String?
  override_at            DateTime?
  delegated_from_user_id String?
  delegated_from_user    User?              @relation("ApprovalDelegate", fields: [delegated_from_user_id], references: [id])
  policy_id              String?
  policy                 ApprovalPolicy?    @relation(fields: [policy_id], references: [id], onDelete: SetNull)
  created_at             DateTime           @default(now())
  updated_at             DateTime           @updatedAt

  // Optimizes: findPending, notifications.cron scanApprovalsPending (status + created_at)
  @@index([status, created_at])
  // Optimizes: entity lookups (approval by entity_type + entity_id)
  @@index([entity_type, entity_id])
}

model Decision {
  id                  String         @id @default(uuid())
  title               String
  decision_type       String
  context             String
  proposed_by         String
  proposer            User           @relation("DecisionProposer", fields: [proposed_by], references: [id])
  impact_scope        String
  final_decision      String?
  status              DecisionStatus @default(proposed)
  tier                GovernanceTier @default(tier_1)
  required_role_codes String[]       @default([])
  resolved_by         String?
  resolved_at         DateTime?
  linked_task_id      String?
  linked_task         Task?          @relation("DecisionTask", fields: [linked_task_id], references: [id])
  linked_mission_id   String?
  linked_mission      Mission?       @relation("DecisionMission", fields: [linked_mission_id], references: [id])
  created_at          DateTime       @default(now())
  updated_at          DateTime       @updatedAt
  votes               DecisionVote[]
}

model ApprovalPolicy {
  id                  String        @id @default(uuid())
  // TODO(p2-05): add `node Node @relation(fields: [node_id], references: [id], onDelete: Restrict)`
  // and the `approval_policies ApprovalPolicy[]` back-relation once Task 5 introduces `Node`.
  node_id             String        @default("11111111-1111-4111-8111-111111111111")
  scope               ApprovalScope
  domain              TaskDomain?
  required_role_codes String[]
  min_approvals       Int           @default(1)
  mode                ApprovalMode  @default(all)
  is_default          Boolean       @default(false)
  created_at          DateTime      @default(now()) @db.Timestamptz(3)
  updated_at          DateTime      @updatedAt @db.Timestamptz(3)
  approvals           Approval[]

  @@unique([node_id, scope, domain])
  @@index([node_id, is_default])
}

model DecisionVote {
  id          String    @id @default(uuid())
  decision_id String
  decision    Decision  @relation(fields: [decision_id], references: [id], onDelete: Cascade)
  user_id     String
  user        User      @relation("DecisionVoter", fields: [user_id], references: [id])
  role_code   String
  vote        VoteValue
  notes       String?
  created_at  DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([decision_id, user_id])
  @@index([decision_id])
}

model ReadinessSignal {
  id           String         @id @default(uuid())
  // TODO(p2-05): add `node Node @relation(fields: [node_id], references: [id], onDelete: Restrict)`
  // and the `readiness_signals ReadinessSignal[]` back-relation once Task 5 introduces `Node`.
  node_id      String         @default("11111111-1111-4111-8111-111111111111")
  meter_id     String
  meter        ReadinessMeter @relation(fields: [meter_id], references: [id], onDelete: Cascade)
  source_event String
  source_type  String
  source_id    String
  value        Decimal        @db.Decimal(14, 4)
  created_at   DateTime       @default(now()) @db.Timestamptz(3)

  @@index([meter_id, created_at(sort: Desc)])
  @@index([source_type, source_id])
}

model ReadinessSnapshot {
  id       String         @id @default(uuid())
  // TODO(p2-05): add `node Node @relation(fields: [node_id], references: [id], onDelete: Restrict)`
  // and the `readiness_snapshots ReadinessSnapshot[]` back-relation once Task 5 introduces `Node`.
  node_id  String         @default("11111111-1111-4111-8111-111111111111")
  meter_id String
  meter    ReadinessMeter @relation(fields: [meter_id], references: [id], onDelete: Cascade)
  date     DateTime       @db.Date
  value    Decimal        @db.Decimal(6, 2)

  @@unique([meter_id, date])
  @@index([node_id, date])
}

model ApprovalDelegation {
  id           String   @id @default(uuid())
  from_user_id String
  from_user    User     @relation("DelegationFrom", fields: [from_user_id], references: [id])
  to_user_id   String
  to_user      User     @relation("DelegationTo", fields: [to_user_id], references: [id])
  start_date   DateTime
  end_date     DateTime
  created_by   String
  creator      User     @relation("DelegationCreator", fields: [created_by], references: [id])
  active       Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  // Optimizes: getActiveDelegationForUser (to_user_id + active + date range)
  @@index([to_user_id, active, start_date, end_date])
  // Optimizes: findActive (from_user_id + active + date range)
  @@index([from_user_id, active])
}

model ReadinessMeter {
  id            String               @id @default(uuid())
  code          String               @unique
  name          String
  description   String
  current_value Float                @default(0)
  target_value  Float                @default(100)
  weight        Float                @default(1.0)
  mode          MeterMode            @default(task_driven)
  formula_key   String?
  updated_at    DateTime             @updatedAt
  tasks         Task[]
  events        TaskReadinessEvent[]
  signals       ReadinessSignal[]
  snapshots     ReadinessSnapshot[]
}

model TaskReadinessEvent {
  id                 String         @id @default(uuid())
  task_id            String
  task               Task           @relation(fields: [task_id], references: [id])
  readiness_meter_id String
  readiness_meter    ReadinessMeter @relation(fields: [readiness_meter_id], references: [id])
  value              Int
  applied            Boolean        @default(true)
  revoked_at         DateTime?
  created_at         DateTime       @default(now())
}

model Kpi {
  id            String   @id @default(uuid())
  name          String
  description   String
  unit          String
  target_value  Float    @default(0)
  current_value Float    @default(0)
  status        String   @default("on_track")
  domain        String
  updated_at    DateTime @updatedAt
  tasks         Task[]
}

model SystemSetting {
  key        String   @id
  value      String
  updated_at DateTime @updatedAt
}

model Zone {
  id               String            @id @default(uuid())
  name             String
  zone_type        String
  owner_user_id    String?
  owner            User?             @relation(fields: [owner_user_id], references: [id])
  status           String            @default("planned")
  notes            String?
  recipes          Recipe[]
  IngredientStocks IngredientStock[]
  StockMovements   StockMovement[]
  PurchaseOrders   PurchaseOrder[]
  prepBatches      PrepBatch[]
  wasteLogs        WasteLog[]
  orders           Order[]
  events           Event[]
}

model Brand {
  id                 String            @id @default(uuid())
  name               String
  brand_type         String
  status             String            @default("idea")
  owner_user_id      String?
  owner              User?             @relation(fields: [owner_user_id], references: [id])
  notes              String?
  assets             Asset[]
  recipes            Recipe[]
  menu_categories    MenuCategory[]
  events             Event[]
  products           Product[]
  product_categories ProductCategory[]
}

model Channel {
  id           String @id @default(uuid())
  name         String
  channel_type String
  status       String @default("planned")
}

model Asset {
  id               String   @id @default(uuid())
  name             String
  asset_type       String
  linked_task_id   String?
  linked_task      Task?    @relation(fields: [linked_task_id], references: [id])
  linked_brand_id  String?
  linked_brand     Brand?   @relation(fields: [linked_brand_id], references: [id])
  linked_recipe_id String?
  linked_recipe    Recipe?  @relation(fields: [linked_recipe_id], references: [id])
  url              String
  status           String   @default("draft")
  created_by       String
  creator          User     @relation(fields: [created_by], references: [id])
  created_at       DateTime @default(now())
}

model Recipe {
  id               String          @id @default(uuid())
  name             String
  description      String
  prep_steps       String?
  cooking_method   String?
  yield_qty        Decimal
  yield_unit       String
  portion_size     String
  shelf_life_hours Int?
  brand_id         String?
  zone_id          String?
  image_url        String?
  computed_cost    Decimal?
  status           RecipeStatus    @default(draft)
  preparation_type PreparationType @default(scratch)
  parent_recipe_id String?
  version          Int             @default(1)
  created_by       String
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt
  brand            Brand?          @relation(fields: [brand_id], references: [id])
  zone             Zone?           @relation(fields: [zone_id], references: [id])
  creator          User            @relation("RecipeCreator", fields: [created_by], references: [id])
  parent_recipe    Recipe?         @relation("RecipeVersions", fields: [parent_recipe_id], references: [id], onDelete: SetNull)
  versions         Recipe[]        @relation("RecipeVersions")
  RecipeLines      RecipeLine[]    @relation("RecipeLines")
  SourceLines      RecipeLine[]    @relation("SourceRecipeLines")
  MenuItems        MenuItem[]
  products         Product[]
  linked_assets    Asset[]
  prepBatches      PrepBatch[]
}

model RecipeLine {
  id               String      @id @default(uuid())
  recipe_id        String
  input_type       String
  ingredient_id    String?
  source_recipe_id String?
  quantity         Decimal
  unit             String
  prep_notes       String?
  sort_order       Int         @default(0)
  recipe           Recipe      @relation("RecipeLines", fields: [recipe_id], references: [id])
  ingredient       Ingredient? @relation(fields: [ingredient_id], references: [id])
  source_recipe    Recipe?     @relation("SourceRecipeLines", fields: [source_recipe_id], references: [id])

  // Optimizes: recipe BOM loading (all lines for a recipe)
  @@index([recipe_id])
}

model IngredientCategory {
  id          String       @id @default(uuid())
  name        String       @unique
  sort_order  Int          @default(0)
  is_default  Boolean      @default(false)
  ingredients Ingredient[]
}

model Ingredient {
  id                 String              @id @default(uuid())
  name               String
  usage_type         UsageType           @default(recipe_input)
  category_id        String?
  base_unit          String
  min_stock_level    Decimal
  created_at         DateTime            @default(now())
  updated_at         DateTime            @updatedAt
  category_obj       IngredientCategory? @relation(fields: [category_id], references: [id])
  RecipeLines        RecipeLine[]
  VendorPrices       VendorPrice[]
  IngredientStocks   IngredientStock[]
  StockMovements     StockMovement[]
  PurchaseOrderLines PurchaseOrderLine[]
  wasteLogs          WasteLog[]
}

model UnitConversion {
  id        String  @id @default(uuid())
  from_unit String
  to_unit   String
  factor    Decimal

  @@unique([from_unit, to_unit])
}

model Vendor {
  id             String          @id @default(uuid())
  name           String
  phone          String?
  email          String?
  address        String?
  payment_terms  String?
  status         String          @default("active")
  created_at     DateTime        @default(now())
  VendorPrices   VendorPrice[]
  PurchaseOrders PurchaseOrder[]
}

model VendorPrice {
  id             String     @id @default(uuid())
  vendor_id      String
  ingredient_id  String
  price          Decimal
  unit           String
  effective_date DateTime
  created_at     DateTime   @default(now())
  vendor         Vendor     @relation(fields: [vendor_id], references: [id])
  ingredient     Ingredient @relation(fields: [ingredient_id], references: [id])

  // Optimizes: getPricesForIngredient, procurement inventory valuation (latest price per ingredient)
  @@index([ingredient_id, effective_date(sort: Desc)])
  // Optimizes: vendor price lookups by vendor
  @@index([vendor_id])
}

model MenuCategory {
  id         String     @id @default(uuid())
  name       String
  brand_id   String
  sort_order Int        @default(0)
  status     String     @default("active")
  brand      Brand      @relation(fields: [brand_id], references: [id])
  MenuItems  MenuItem[]

  // Optimizes: findCategories by brand_id
  @@index([brand_id])
}

model MenuItem {
  id          String       @id @default(uuid())
  recipe_id   String
  category_id String
  name        String
  base_price  Decimal
  image_url   String?
  available   Boolean      @default(true)
  status      String       @default("active")
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt
  recipe      Recipe       @relation(fields: [recipe_id], references: [id])
  category    MenuCategory @relation(fields: [category_id], references: [id])
  orderItems  OrderItem[]

  // Optimizes: findItems by category_id
  @@index([category_id])
  // Optimizes: getAllServingsAvailable (active items), findItems filtered by status
  @@index([status])
}

model ProductCategory {
  id            String        @id @default(uuid())
  // TODO(p2-05): add `node Node @relation(fields: [node_id], references: [id], onDelete: Restrict)`
  // and the `product_categories ProductCategory[]` back-relation once Task 5 introduces `Node`.
  node_id       String        @default("11111111-1111-4111-8111-111111111111")
  brand_id      String
  brand         Brand         @relation(fields: [brand_id], references: [id])
  name          String
  slug          String
  sort_order    Int           @default(0)
  product_types ProductType[] @default([])
  status        ProductStatus @default(active)
  created_at    DateTime      @default(now()) @db.Timestamptz(3)
  updated_at    DateTime      @updatedAt @db.Timestamptz(3)
  products      Product[]

  @@unique([node_id, slug])
  @@index([brand_id])
}

model Product {
  id              String           @id @default(uuid())
  // TODO(p2-05): add `node Node @relation(fields: [node_id], references: [id], onDelete: Restrict)`
  // and the `products Product[]` back-relation once Task 5 introduces `Node`.
  node_id         String           @default("11111111-1111-4111-8111-111111111111")
  brand_id        String
  brand           Brand            @relation(fields: [brand_id], references: [id])
  category_id     String
  category        ProductCategory  @relation(fields: [category_id], references: [id])
  type            ProductType
  name            String
  slug            String
  description     String           @default("")
  story           String?
  base_price      Decimal          @db.Decimal(12, 2)
  tax_rate        Decimal          @default(0) @db.Decimal(5, 2)
  hsn_code        String?
  fulfilment      FulfilmentType   @default(local)
  stock_mode      StockMode        @default(derived_from_recipe)
  recipe_id       String?
  recipe          Recipe?          @relation(fields: [recipe_id], references: [id], onDelete: Restrict)
  event_id        String?
  event           Event?           @relation(fields: [event_id], references: [id], onDelete: Restrict)
  weight_grams    Int?
  dimensions_cm   Json?
  shelf_life_days Int?
  is_featured     Boolean          @default(false)
  rating_avg      Decimal?         @db.Decimal(3, 2)
  rating_count    Int              @default(0)
  status          ProductStatus    @default(draft)
  search_text     String           @default("")
  created_by      String?
  updated_by      String?
  created_at      DateTime         @default(now()) @db.Timestamptz(3)
  updated_at      DateTime         @updatedAt @db.Timestamptz(3)
  variants        ProductVariant[]
  media           ProductMedia[]
  orderItems      OrderItem[]

  @@unique([node_id, slug])
  @@index([node_id, type, status])
  @@index([category_id])
  @@index([recipe_id])
}

model ProductVariant {
  id                  String        @id @default(uuid())
  product_id          String
  product             Product       @relation(fields: [product_id], references: [id], onDelete: Cascade)
  name                String
  sku                 String        @unique
  price_delta         Decimal       @default(0) @db.Decimal(12, 2)
  stock_on_hand       Decimal       @default(0) @db.Decimal(14, 4)
  low_stock_threshold Decimal?      @db.Decimal(14, 4)
  is_default          Boolean       @default(false)
  status              ProductStatus @default(active)
  created_at          DateTime      @default(now()) @db.Timestamptz(3)
  updated_at          DateTime      @updatedAt @db.Timestamptz(3)
  orderItems          OrderItem[]

  @@index([product_id])
}

model ProductMedia {
  id         String    @id @default(uuid())
  product_id String
  product    Product   @relation(fields: [product_id], references: [id], onDelete: Cascade)
  url        String
  alt        String    @default("")
  sort_order Int       @default(0)
  kind       MediaKind @default(image)

  @@index([product_id, sort_order])
}

model ChannelModifier {
  id             String       @id @default(uuid())
  channel        OrderChannel
  modifier_type  String
  modifier_value Decimal
  status         String       @default("active")

  @@unique([channel])
}

model IngredientStock {
  id               String     @id @default(uuid())
  ingredient_id    String
  zone_id          String
  current_quantity Decimal
  updated_at       DateTime   @updatedAt
  ingredient       Ingredient @relation(fields: [ingredient_id], references: [id])
  zone             Zone       @relation(fields: [zone_id], references: [id])

  @@unique([ingredient_id, zone_id])
}

model StockMovement {
  id                String       @id @default(uuid())
  ingredient_id     String
  zone_id           String
  movement_type     MovementType
  quantity          Decimal // in base_unit, signed (+/-)
  original_quantity Decimal // in original unit for display
  unit              String // original unit for display
  reason            String?
  reference_type    String? // "purchase_order" | "prep_batch" | "order" | "waste_log"
  reference_id      String?
  created_by        String?
  actor_type        ActorType    @default(user)
  actor_id          String?
  created_at        DateTime     @default(now())
  ingredient        Ingredient   @relation(fields: [ingredient_id], references: [id])
  zone              Zone         @relation(fields: [zone_id], references: [id])
  creator           User?        @relation("StockMovementCreator", fields: [created_by], references: [id])

  // Optimizes: inventory getMovements by ingredient (paginated, ordered by created_at)
  @@index([ingredient_id, created_at(sort: Desc)])
  // Optimizes: zone+date movement queries
  @@index([zone_id, created_at])
}

model PurchaseOrder {
  id              String              @id @default(uuid())
  vendor_id       String
  zone_id         String // receiving needs a zone for IngredientStock upsert
  status          PurchaseOrderStatus @default(draft)
  total_amount    Decimal             @default(0)
  notes           String?
  ordered_by      String
  ordered_at      DateTime?
  received_at     DateTime?
  linked_task_id  String?
  created_at      DateTime            @default(now())
  updated_at      DateTime            @updatedAt
  vendor          Vendor              @relation(fields: [vendor_id], references: [id])
  zone            Zone                @relation(fields: [zone_id], references: [id])
  ordered_by_user User                @relation("PurchaseOrderer", fields: [ordered_by], references: [id])
  linked_task     Task?               @relation(fields: [linked_task_id], references: [id], onDelete: SetNull)
  lines           PurchaseOrderLine[]

  // Optimizes: procurement pending PO count, PO status breakdown
  @@index([status])
  // Optimizes: procurement vendor spend this month (status + ordered_at range)
  @@index([status, ordered_at])
  // Optimizes: vendor-scoped PO lookups
  @@index([vendor_id])
  // Optimizes: task-linked PO lookups
  @@index([linked_task_id])
}

model PurchaseOrderLine {
  id                String        @id @default(uuid())
  po_id             String
  ingredient_id     String
  quantity          Decimal
  unit              String
  unit_cost         Decimal
  received_quantity Decimal?
  purchase_order    PurchaseOrder @relation(fields: [po_id], references: [id], onDelete: Cascade)
  ingredient        Ingredient    @relation(fields: [ingredient_id], references: [id])

  // Optimizes: PO lines loading by po_id
  @@index([po_id])
}

model PrepBatch {
  id                 String          @id @default(uuid())
  recipe_id          String
  zone_id            String
  quantity_produced  Decimal
  quantity_remaining Decimal
  unit               String
  prepared_by        String
  expires_at         DateTime?
  status             PrepBatchStatus @default(active)
  created_at         DateTime        @default(now())
  recipe             Recipe          @relation(fields: [recipe_id], references: [id])
  zone               Zone            @relation(fields: [zone_id], references: [id])
  creator            User            @relation("PrepBatchCreator", fields: [prepared_by], references: [id])
  wasteLogs          WasteLog[]

  // Optimizes: FIFO batch lookup by recipe+zone+status (prep-batches, KDS deductions, menu availability)
  @@index([recipe_id, status, zone_id])
  // Optimizes: kitchen-metrics active batch count, prep-batches findAll by zone+status
  @@index([zone_id, status])
  // Optimizes: kitchen-metrics today's batches for waste percentage
  @@index([created_at])
}

model WasteLog {
  id            String      @id @default(uuid())
  waste_type    String // "ingredient" | "prep_batch"
  ingredient_id String?
  prep_batch_id String?
  quantity      Decimal
  unit          String
  reason        String // "spoilage" | "over_prep" | "cooking_error" | "expired" | "other"
  reason_notes  String?
  cost_impact   Decimal
  logged_by     String? // nullable for system-generated expiry entries
  zone_id       String
  created_at    DateTime    @default(now())
  ingredient    Ingredient? @relation(fields: [ingredient_id], references: [id])
  prep_batch    PrepBatch?  @relation(fields: [prep_batch_id], references: [id])
  zone          Zone        @relation(fields: [zone_id], references: [id])
  creator       User?       @relation("WasteLogCreator", fields: [logged_by], references: [id])

  // Optimizes: kitchen-metrics waste today aggregate (created_at filter)
  @@index([created_at])
  // Optimizes: waste by zone queries
  @@index([zone_id, created_at])
}

model Customer {
  id         String   @id @default(uuid())
  phone      String   @unique
  name       String?
  email      String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  bookings  EventBooking[]
  orders    Order[]
  feedbacks Feedback[]
  addresses CustomerAddress[]

  @@index([phone])
}

model CustomerAddress {
  id          String   @id @default(uuid())
  customer_id String
  customer    Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  label       String // "Home" | "Work" | "Other"
  address     String
  landmark    String?
  pincode     String
  lat         Float?
  lng         Float?
  is_default  Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([customer_id])
}

model Order {
  id                      String          @id @default(uuid())
  order_number            Int             @unique @default(autoincrement())
  channel                 OrderChannel
  status                  OrderStatus     @default(placed)
  table_number            String?
  customer_name           String?
  customer_phone          String?
  delivery_address        String?
  delivery_assigned_to    String?
  delivery_status         DeliveryStatus?
  placed_via              OrderSource     @default(pos)
  customer_id             String?
  customer                Customer?       @relation(fields: [customer_id], references: [id])
  subtotal                Decimal
  channel_modifier_amount Decimal         @default(0)
  discount_amount         Decimal         @default(0)
  shipping_amount         Decimal         @default(0)
  tax_amount              Decimal         @default(0)
  total                   Decimal
  loyalty_points_earned   Int             @default(0)
  loyalty_points_redeemed Int             @default(0)
  idempotency_key         String?         @unique
  address_snapshot        Json?
  notes                   String?
  created_by              String?
  updated_by              String?
  zone_id                 String?
  created_at              DateTime        @default(now())
  updated_at              DateTime        @updatedAt
  creator                 User?           @relation("OrderCreator", fields: [created_by], references: [id])
  zone                    Zone?           @relation(fields: [zone_id], references: [id])
  items                   OrderItem[]
  payment                 Payment?
  feedbacks               Feedback[]

  // Optimizes: analytics date-range + status filters, orders list by status+date, daily summary
  @@index([status, created_at])
  // Optimizes: orders filtered by channel (getOrders channel filter)
  @@index([channel])
  // Optimizes: KDS getActiveOrders grouped by zone, kitchen-metrics zone utilization
  @@index([zone_id, status])
  // Optimizes: customer order history lookups (Phase 24)
  @@index([customer_id])
}

model OrderItem {
  id           String          @id @default(uuid())
  order_id     String
  menu_item_id String
  quantity     Int
  unit_price   Decimal
  item_notes   String?
  status       OrderItemStatus @default(pending)
  fulfilment   FulfilmentType  @default(local)
  tax_rate     Decimal         @default(0)
  ready_at     DateTime?
  created_at   DateTime        @default(now())
  order        Order           @relation(fields: [order_id], references: [id], onDelete: Cascade)
  menu_item    MenuItem        @relation(fields: [menu_item_id], references: [id])
  // Nullable while MenuItem is still the source of truth; Task 11 makes product_id
  // required and drops menu_item_id.
  product_id   String?
  product      Product?        @relation(fields: [product_id], references: [id])
  variant_id   String?
  variant      ProductVariant? @relation(fields: [variant_id], references: [id])

  // Optimizes: KDS findMany by order_id, all-items-ready check
  @@index([order_id])
  // Optimizes: kitchen-metrics items_completed_today (status + ready_at filter)
  @@index([status, ready_at])
  // Optimizes: analytics getTopItems groupBy menu_item_id
  @@index([menu_item_id])
  // Optimizes: analytics getTopItems groupBy product_id (Task 11 onward)
  @@index([product_id])
}

model Payment {
  id                  String        @id @default(uuid())
  order_id            String        @unique
  method              PaymentMethod
  amount              Decimal
  status              PaymentStatus @default(pending)
  refunded_amount     Decimal       @default(0)
  notes               String?
  razorpay_order_id   String?       @unique
  razorpay_payment_id String?       @unique
  created_at          DateTime      @default(now())
  order               Order         @relation(fields: [order_id], references: [id])
}

model Notification {
  id             String                @id @default(uuid())
  user_id        String
  user           User                  @relation(fields: [user_id], references: [id])
  type           NotificationType
  channel        NotificationChannel[] @default([in_app])
  title          String
  body           String
  link_url       String?
  reference_id   String? // ID of related entity (task_id, order_id, ingredient_id, approval_id)
  reference_type String? // "task" | "order" | "ingredient" | "approval"
  is_read        Boolean               @default(false)
  is_email_sent  Boolean               @default(false)
  created_at     DateTime              @default(now())

  @@index([user_id, is_read, created_at(sort: Desc)])
  @@index([user_id, type, reference_id])
}

model Feedback {
  id             String    @id @default(uuid())
  order_id       String?
  order          Order?    @relation(fields: [order_id], references: [id])
  rating         Int // 1-5
  comment        String?
  customer_name  String?
  customer_phone String?
  customer_id    String?
  customer       Customer? @relation(fields: [customer_id], references: [id])
  created_at     DateTime  @default(now())

  // Optimizes: findAll by order_id
  @@index([order_id])
  // Optimizes: findAll date range filter + pagination ordered by created_at
  @@index([created_at(sort: Desc)])
  // Optimizes: findAll rating filter
  @@index([rating])
  // Optimizes: customer feedback history lookups
  @@index([customer_id])
}

model Event {
  id          String         @id @default(uuid())
  title       String
  event_type  EventType
  date        DateTime
  capacity    Int
  price       Decimal
  zone_id     String?
  brand_id    String?
  description String?
  image_url   String?
  status      EventStatus    @default(upcoming)
  created_at  DateTime       @default(now())
  updated_at  DateTime       @updatedAt
  zone        Zone?          @relation(fields: [zone_id], references: [id])
  brand       Brand?         @relation(fields: [brand_id], references: [id])
  bookings    EventBooking[]
  products    Product[]
}

model EventBooking {
  id                  String        @id @default(uuid())
  event_id            String
  event               Event         @relation(fields: [event_id], references: [id], onDelete: Cascade)
  customer_name       String
  customer_phone      String
  guests              Int
  customer_id         String?
  customer            Customer?     @relation(fields: [customer_id], references: [id])
  razorpay_order_id   String?       @unique
  razorpay_payment_id String?       @unique
  payment_status      String        @default("pending") // pending | paid | refunded | free
  status              BookingStatus @default(confirmed)
  hold_expires_at     DateTime?
  payment_amount      Decimal?
  created_at          DateTime      @default(now())

  @@unique([event_id, customer_phone])
  @@index([customer_id])
  @@index([razorpay_order_id])
}

model GuideSection {
  id           String      @id @default(uuid())
  title        String
  slug         String      @unique
  description  String?
  icon         String?
  accent_color String?
  sort_order   Int         @default(0)
  role_codes   String[]
  status       String      @default("draft")
  created_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt
  pages        GuidePage[]

  @@index([status])
  @@index([sort_order])
}

model GuidePage {
  id                  String       @id @default(uuid())
  section_id          String
  section             GuideSection @relation(fields: [section_id], references: [id], onDelete: Cascade)
  title               String
  slug                String
  sort_order          Int          @default(0)
  content             String       @db.Text
  summary             String?
  estimated_read_time Int?
  status              String       @default("draft")
  search_text         String       @default("")
  created_at          DateTime     @default(now())
  updated_at          DateTime     @updatedAt

  @@unique([section_id, slug])
  @@index([section_id, sort_order])
  @@index([status])
}

model ExportRecord {
  id              String   @id @default(uuid())
  report_type     String
  format          String // "csv" | "xlsx"
  filters_applied String?  @db.Text
  file_size_bytes Int
  r2_key          String
  download_url    String
  generated_by    String
  user            User     @relation(fields: [generated_by], references: [id])
  status          String   @default("completed")
  created_at      DateTime @default(now())

  @@index([report_type, created_at(sort: Desc)])
  @@index([generated_by, created_at(sort: Desc)])
  @@index([status, created_at(sort: Desc)])
}

model Conversation {
  id           String                    @id @default(uuid())
  type         String // "direct" | "group"
  name         String? // null for 1-1 chats, required for groups
  avatar_key   String? // R2 key for group avatar (optional)
  created_by   String // user_id of creator
  created_at   DateTime                  @default(now())
  updated_at   DateTime                  @updatedAt
  participants ConversationParticipant[]
  messages     Message[]

  @@index([created_by])
  @@index([updated_at(sort: Desc)])
}

model ConversationParticipant {
  id              String       @id @default(uuid())
  conversation_id String
  conversation    Conversation @relation(fields: [conversation_id], references: [id])
  user_id         String
  user            User         @relation(fields: [user_id], references: [id])
  last_read_at    DateTime?
  joined_at       DateTime     @default(now())

  @@unique([conversation_id, user_id])
  @@index([user_id])
  @@index([conversation_id])
}

model Message {
  id              String       @id @default(uuid())
  conversation_id String
  conversation    Conversation @relation(fields: [conversation_id], references: [id])
  sender_id       String
  sender          User         @relation(fields: [sender_id], references: [id])
  content         String?      @db.Text
  attachment_key  String?
  attachment_url  String?
  attachment_name String?
  attachment_type String? // "image" | "file"
  created_at      DateTime     @default(now())

  @@index([conversation_id, created_at(sort: Desc)])
  @@index([sender_id])
}
