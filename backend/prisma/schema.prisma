datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Role {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String
  permissions String[]
  created_at  DateTime @default(now())
  users       User[]
}

model User {
  id                      String               @id @default(uuid())
  name                    String
  email                   String               @unique
  password_hash           String
  role_id                 String
  role                    Role                 @relation(fields: [role_id], references: [id])
  function                String
  status                  String               @default("active")
  xp_total                Int                  @default(0)
  level                   Int                  @default(1)
  streak_days             Int                  @default(0)
  created_at              DateTime             @default(now())
  updated_at              DateTime             @updatedAt
  refresh_tokens          RefreshToken[]
  reset_tokens            PasswordResetToken[]
  owned_tasks             Task[]               @relation("TaskOwner")
  created_tasks           Task[]               @relation("TaskCreator")
  evidence                Evidence[]
  reviewed_evidence       Evidence[]           @relation("EvidenceReviewer")
  approved_approvals      Approval[]           @relation("ApprovalApprover")
  overridden_approvals    Approval[]           @relation("ApprovalOverrider")
  delegated_approvals     Approval[]           @relation("ApprovalDelegate")
  proposed_decisions      Decision[]           @relation("DecisionProposer")
  owned_quests            Quest[]
  owned_zones             Zone[]
  owned_brands            Brand[]
  created_assets          Asset[]
  delegations_from        ApprovalDelegation[] @relation("DelegationFrom")
  delegations_to          ApprovalDelegation[] @relation("DelegationTo")
  delegations_created     ApprovalDelegation[] @relation("DelegationCreator")
  created_recipes         Recipe[]             @relation("RecipeCreator")
  stockMovements          StockMovement[]      @relation("StockMovementCreator")
  purchaseOrders          PurchaseOrder[]      @relation("PurchaseOrderer")
  prepBatches             PrepBatch[]          @relation("PrepBatchCreator")
  wasteLogs               WasteLog[]           @relation("WasteLogCreator")
  orders                  Order[]              @relation("OrderCreator")
}

model RefreshToken {
  id         String    @id @default(uuid())
  user_id    String
  user       User      @relation(fields: [user_id], references: [id])
  token_hash String
  revoked_at DateTime?
  expires_at DateTime
  created_at DateTime  @default(now())

  @@index([user_id])
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  user_id    String
  user       User      @relation(fields: [user_id], references: [id])
  token_hash String
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())
}

model Mission {
  id               String     @id @default(uuid())
  title            String
  description      String
  phase            String     @default("setup")
  scope            String     @default("food")
  status           String     @default("planned")
  start_date       DateTime?
  end_date         DateTime?
  progress_percent Float      @default(0)
  created_by       String
  created_at       DateTime   @default(now())
  updated_at       DateTime   @updatedAt
  quests           Quest[]
  tasks            Task[]
  decisions        Decision[] @relation("DecisionMission")
}

model Quest {
  id                     String    @id @default(uuid())
  mission_id             String
  mission                Mission   @relation(fields: [mission_id], references: [id])
  title                  String
  description            String
  week_number            Int
  owner_user_id          String
  owner                  User      @relation(fields: [owner_user_id], references: [id])
  status                 String    @default("planned")
  baseline_task_count    Int       @default(0)
  core_progress_percent  Float     @default(0)
  adhoc_progress_percent Float     @default(0)
  progress_percent       Float     @default(0)
  start_date             DateTime?
  end_date               DateTime?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt
  tasks                  Task[]
}

model Task {
  id                   String               @id @default(uuid())
  mission_id           String
  mission              Mission              @relation(fields: [mission_id], references: [id])
  quest_id             String?
  quest                Quest?               @relation(fields: [quest_id], references: [id])
  title                String
  description          String
  task_type            String               @default("core")
  domain               String
  owner_user_id        String
  owner                User                 @relation("TaskOwner", fields: [owner_user_id], references: [id])
  created_by           String
  creator              User                 @relation("TaskCreator", fields: [created_by], references: [id])
  status               String               @default("todo")
  priority             String               @default("medium")
  xp                   Int                  @default(25)
  valid_xp             Int                  @default(0)
  verified             Boolean              @default(false)
  valid                Boolean              @default(false)
  requires_approval    Boolean              @default(true)
  blocked              Boolean              @default(false)
  blocked_reason       String?
  depends_on_task_id   String?
  depends_on           Task?                @relation("TaskDependency", fields: [depends_on_task_id], references: [id])
  dependents           Task[]               @relation("TaskDependency")
  readiness_meter_id   String?
  readiness_meter      ReadinessMeter?      @relation(fields: [readiness_meter_id], references: [id])
  readiness_value      Int                  @default(0)
  kpi_id               String?
  kpi                  Kpi?                 @relation(fields: [kpi_id], references: [id])
  due_date             DateTime?
  completed_at         DateTime?
  created_at           DateTime             @default(now())
  updated_at           DateTime             @updatedAt
  evidence             Evidence[]
  approvals            Approval[]           @relation("TaskApprovals")
  readiness_events     TaskReadinessEvent[]
  linked_assets        Asset[]
  linked_decisions     Decision[]           @relation("DecisionTask")

  @@index([owner_user_id, status])
  @@index([quest_id, valid])
  @@index([mission_id])
}

model Evidence {
  id              String    @id @default(uuid())
  task_id         String
  task            Task      @relation(fields: [task_id], references: [id])
  uploaded_by     String
  uploader        User      @relation(fields: [uploaded_by], references: [id])
  type            String
  url             String
  notes           String?
  approval_status String    @default("pending")
  reviewed_by     String?
  reviewer        User?     @relation("EvidenceReviewer", fields: [reviewed_by], references: [id])
  reviewed_at     DateTime?
  created_at      DateTime  @default(now())
}

model Approval {
  id                     String    @id @default(uuid())
  entity_type            String
  entity_id              String
  task                   Task?     @relation("TaskApprovals", fields: [entity_id], references: [id])
  approval_scope         String
  required_role_code     String
  approved_by            String?
  approver               User?     @relation("ApprovalApprover", fields: [approved_by], references: [id])
  status                 String    @default("pending")
  notes                  String?
  override_by            String?
  overrider              User?     @relation("ApprovalOverrider", fields: [override_by], references: [id])
  override_reason        String?
  override_at            DateTime?
  delegated_from_user_id String?
  delegated_from_user    User?     @relation("ApprovalDelegate", fields: [delegated_from_user_id], references: [id])
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt
}

model Decision {
  id                String   @id @default(uuid())
  title             String
  decision_type     String
  context           String
  proposed_by       String
  proposer          User     @relation("DecisionProposer", fields: [proposed_by], references: [id])
  impact_scope      String
  final_decision    String?
  status            String   @default("proposed")
  linked_task_id    String?
  linked_task       Task?    @relation("DecisionTask", fields: [linked_task_id], references: [id])
  linked_mission_id String?
  linked_mission    Mission? @relation("DecisionMission", fields: [linked_mission_id], references: [id])
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
}

model ApprovalDelegation {
  id           String   @id @default(uuid())
  from_user_id String
  from_user    User     @relation("DelegationFrom", fields: [from_user_id], references: [id])
  to_user_id   String
  to_user      User     @relation("DelegationTo", fields: [to_user_id], references: [id])
  start_date   DateTime
  end_date     DateTime
  created_by   String
  creator      User     @relation("DelegationCreator", fields: [created_by], references: [id])
  active       Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
}

model ReadinessMeter {
  id            String               @id @default(uuid())
  code          String               @unique
  name          String
  description   String
  current_value Float                @default(0)
  target_value  Float                @default(100)
  weight        Float                @default(1.0)
  updated_at    DateTime             @updatedAt
  tasks         Task[]
  events        TaskReadinessEvent[]
}

model TaskReadinessEvent {
  id                 String         @id @default(uuid())
  task_id            String
  task               Task           @relation(fields: [task_id], references: [id])
  readiness_meter_id String
  readiness_meter    ReadinessMeter @relation(fields: [readiness_meter_id], references: [id])
  value              Int
  applied            Boolean        @default(true)
  revoked_at         DateTime?
  created_at         DateTime       @default(now())
}

model Kpi {
  id            String   @id @default(uuid())
  name          String
  description   String
  unit          String
  target_value  Float    @default(0)
  current_value Float    @default(0)
  status        String   @default("on_track")
  domain        String
  updated_at    DateTime @updatedAt
  tasks         Task[]
}

model SystemSetting {
  key        String   @id
  value      String
  updated_at DateTime @updatedAt
}

model Zone {
  id               String            @id @default(uuid())
  name             String
  zone_type        String
  owner_user_id    String?
  owner            User?             @relation(fields: [owner_user_id], references: [id])
  status           String            @default("planned")
  notes            String?
  recipes          Recipe[]
  IngredientStocks IngredientStock[]
  StockMovements   StockMovement[]
  PurchaseOrders   PurchaseOrder[]
  prepBatches      PrepBatch[]
  wasteLogs        WasteLog[]
  orders           Order[]
}

model Brand {
  id               String         @id @default(uuid())
  name             String
  brand_type       String
  status           String         @default("idea")
  owner_user_id    String?
  owner            User?          @relation(fields: [owner_user_id], references: [id])
  notes            String?
  assets           Asset[]
  recipes          Recipe[]
  menu_categories  MenuCategory[]
}

model Channel {
  id           String @id @default(uuid())
  name         String
  channel_type String
  status       String @default("planned")
}

model Asset {
  id               String   @id @default(uuid())
  name             String
  asset_type       String
  linked_task_id   String?
  linked_task      Task?    @relation(fields: [linked_task_id], references: [id])
  linked_brand_id  String?
  linked_brand     Brand?   @relation(fields: [linked_brand_id], references: [id])
  linked_recipe_id String?
  linked_recipe    Recipe?  @relation(fields: [linked_recipe_id], references: [id])
  url              String
  status           String   @default("draft")
  created_by       String
  creator          User     @relation(fields: [created_by], references: [id])
  created_at       DateTime @default(now())
}

model Recipe {
  id                String       @id @default(uuid())
  name              String
  description       String
  prep_steps        String
  cooking_method    String
  yield_qty         Decimal
  yield_unit        String
  portion_size      String
  shelf_life_hours  Int?
  brand_id          String?
  zone_id           String?
  image_url         String?
  computed_cost     Decimal?
  status            String       @default("draft")
  created_by        String
  created_at        DateTime     @default(now())
  updated_at        DateTime     @updatedAt
  brand             Brand?       @relation(fields: [brand_id], references: [id])
  zone              Zone?        @relation(fields: [zone_id], references: [id])
  creator           User         @relation("RecipeCreator", fields: [created_by], references: [id])
  RecipeLines       RecipeLine[] @relation("RecipeLines")
  SourceLines       RecipeLine[] @relation("SourceRecipeLines")
  MenuItems         MenuItem[]
  linked_assets     Asset[]
  prepBatches       PrepBatch[]
}

model RecipeLine {
  id               String      @id @default(uuid())
  recipe_id        String
  input_type       String
  ingredient_id    String?
  source_recipe_id String?
  quantity         Decimal
  unit             String
  prep_notes       String?
  sort_order       Int         @default(0)
  recipe           Recipe      @relation("RecipeLines", fields: [recipe_id], references: [id])
  ingredient       Ingredient? @relation(fields: [ingredient_id], references: [id])
  source_recipe    Recipe?     @relation("SourceRecipeLines", fields: [source_recipe_id], references: [id])
}

model Ingredient {
  id              String              @id @default(uuid())
  name            String
  category        String
  base_unit       String
  min_stock_level Decimal
  created_at      DateTime            @default(now())
  updated_at      DateTime            @updatedAt
  RecipeLines     RecipeLine[]
  VendorPrices    VendorPrice[]
  IngredientStocks    IngredientStock[]
  StockMovements      StockMovement[]
  PurchaseOrderLines  PurchaseOrderLine[]
  wasteLogs           WasteLog[]
}

model UnitConversion {
  id        String  @id @default(uuid())
  from_unit String
  to_unit   String
  factor    Decimal

  @@unique([from_unit, to_unit])
}

model Vendor {
  id             String          @id @default(uuid())
  name           String
  phone          String?
  email          String?
  address        String?
  payment_terms  String?
  status         String          @default("active")
  created_at     DateTime        @default(now())
  VendorPrices   VendorPrice[]
  PurchaseOrders PurchaseOrder[]
}

model VendorPrice {
  id             String     @id @default(uuid())
  vendor_id      String
  ingredient_id  String
  price          Decimal
  unit           String
  effective_date DateTime
  created_at     DateTime   @default(now())
  vendor         Vendor     @relation(fields: [vendor_id], references: [id])
  ingredient     Ingredient @relation(fields: [ingredient_id], references: [id])
}

model MenuCategory {
  id         String     @id @default(uuid())
  name       String
  brand_id   String
  sort_order Int        @default(0)
  status     String     @default("active")
  brand      Brand      @relation(fields: [brand_id], references: [id])
  MenuItems  MenuItem[]
}

model MenuItem {
  id          String       @id @default(uuid())
  recipe_id   String
  category_id String
  name        String
  base_price  Decimal
  image_url   String?
  available   Boolean      @default(true)
  status      String       @default("active")
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt
  recipe      Recipe       @relation(fields: [recipe_id], references: [id])
  category    MenuCategory @relation(fields: [category_id], references: [id])
  orderItems  OrderItem[]
}

model ChannelModifier {
  id             String  @id @default(uuid())
  channel_type   String
  modifier_type  String
  modifier_value Decimal
  status         String  @default("active")

  @@unique([channel_type])
}

model IngredientStock {
  id               String     @id @default(uuid())
  ingredient_id    String
  zone_id          String
  current_quantity Decimal
  updated_at       DateTime   @updatedAt
  ingredient       Ingredient @relation(fields: [ingredient_id], references: [id])
  zone             Zone       @relation(fields: [zone_id], references: [id])

  @@unique([ingredient_id, zone_id])
}

model StockMovement {
  id                String     @id @default(uuid())
  ingredient_id     String
  zone_id           String
  movement_type     String     // "received" | "prep_deducted" | "order_deducted" | "waste" | "adjustment"
  quantity          Decimal    // in base_unit, signed (+/-)
  original_quantity Decimal    // in original unit for display
  unit              String     // original unit for display
  reason            String?
  reference_type    String?    // "purchase_order" | "prep_batch" | "order" | "waste_log"
  reference_id      String?
  created_by        String
  created_at        DateTime   @default(now())
  ingredient        Ingredient @relation(fields: [ingredient_id], references: [id])
  zone              Zone       @relation(fields: [zone_id], references: [id])
  creator           User       @relation("StockMovementCreator", fields: [created_by], references: [id])
}

model PurchaseOrder {
  id              String              @id @default(uuid())
  vendor_id       String
  zone_id         String              // receiving needs a zone for IngredientStock upsert
  status          String              @default("draft")  // draft | ordered | received | cancelled
  total_amount    Decimal             @default(0)
  notes           String?
  ordered_by      String
  ordered_at      DateTime?
  received_at     DateTime?
  created_at      DateTime            @default(now())
  updated_at      DateTime            @updatedAt
  vendor          Vendor              @relation(fields: [vendor_id], references: [id])
  zone            Zone                @relation(fields: [zone_id], references: [id])
  ordered_by_user User                @relation("PurchaseOrderer", fields: [ordered_by], references: [id])
  lines           PurchaseOrderLine[]
}

model PurchaseOrderLine {
  id                String        @id @default(uuid())
  po_id             String
  ingredient_id     String
  quantity          Decimal
  unit              String
  unit_cost         Decimal
  received_quantity Decimal?
  purchase_order    PurchaseOrder @relation(fields: [po_id], references: [id], onDelete: Cascade)
  ingredient        Ingredient    @relation(fields: [ingredient_id], references: [id])
}

model PrepBatch {
  id                 String    @id @default(uuid())
  recipe_id          String
  zone_id            String
  quantity_produced  Decimal
  quantity_remaining Decimal
  unit               String
  prepared_by        String
  expires_at         DateTime?
  status             String    @default("active") // active | depleted | expired
  created_at         DateTime  @default(now())
  recipe             Recipe    @relation(fields: [recipe_id], references: [id])
  zone               Zone      @relation(fields: [zone_id], references: [id])
  creator            User      @relation("PrepBatchCreator", fields: [prepared_by], references: [id])
  wasteLogs          WasteLog[]
}

model WasteLog {
  id             String      @id @default(uuid())
  waste_type     String      // "ingredient" | "prep_batch"
  ingredient_id  String?
  prep_batch_id  String?
  quantity       Decimal
  unit           String
  reason         String      // "spoilage" | "over_prep" | "cooking_error" | "expired" | "other"
  reason_notes   String?
  cost_impact    Decimal
  logged_by      String?     // nullable for system-generated expiry entries
  zone_id        String
  created_at     DateTime    @default(now())
  ingredient     Ingredient? @relation(fields: [ingredient_id], references: [id])
  prep_batch     PrepBatch?  @relation(fields: [prep_batch_id], references: [id])
  zone           Zone        @relation(fields: [zone_id], references: [id])
  creator        User?       @relation("WasteLogCreator", fields: [logged_by], references: [id])
}

model Order {
  id                      String      @id @default(uuid())
  channel                 String      // "dine_in" | "takeaway" | "delivery"
  status                  String      @default("placed") // placed | preparing | ready | served | dispatched | cancelled
  table_number            String?
  customer_name           String?
  customer_phone          String?
  delivery_address        String?
  delivery_assigned_to    String?
  delivery_status         String?
  subtotal                Decimal
  channel_modifier_amount Decimal     @default(0)
  total                   Decimal
  notes                   String?
  created_by              String
  zone_id                 String
  created_at              DateTime    @default(now())
  updated_at              DateTime    @updatedAt
  creator                 User        @relation("OrderCreator", fields: [created_by], references: [id])
  zone                    Zone        @relation(fields: [zone_id], references: [id])
  items                   OrderItem[]
  payment                 Payment?
}

model OrderItem {
  id           String    @id @default(uuid())
  order_id     String
  menu_item_id String
  quantity     Int
  unit_price   Decimal
  item_notes   String?
  status       String    @default("pending") // pending | preparing | ready
  ready_at     DateTime?
  created_at   DateTime  @default(now())
  order        Order     @relation(fields: [order_id], references: [id], onDelete: Cascade)
  menu_item    MenuItem  @relation(fields: [menu_item_id], references: [id])
}

model Payment {
  id         String   @id @default(uuid())
  order_id   String   @unique
  method     String   // "cash" | "card" | "upi"
  amount     Decimal
  status     String   @default("pending") // pending | paid | refunded
  notes      String?
  created_at DateTime @default(now())
  order      Order    @relation(fields: [order_id], references: [id])
}
