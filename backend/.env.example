# Database (Neon PostgreSQL)
# url = pooled connection string (for app queries)
# directUrl = direct connection string (for prisma migrate)
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/konmaxperience?sslmode=require
DIRECT_DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/konmaxperience?sslmode=require

# JWT (shared with frontend middleware — must be identical on both)
JWT_SECRET=<64-char-random-string>

# Email (MailerSend)
MAILERSEND_API_KEY=<your-api-key>
MAILERSEND_FROM_EMAIL=noreply@konma.store

# Frontend URL (CORS + email links)
FRONTEND_URL=https://konma.store

# Cloudflare R2 (Evidence Storage)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<key>
R2_SECRET_ACCESS_KEY=<secret>
R2_BUCKET_NAME=konma-evidence
R2_PUBLIC_URL=https://<bucket>.r2.dev

# Redis (Upstash — optional, notifications disabled without it)
# Get the TCP URL from https://console.upstash.com -> your database
# Format: rediss://default:TOKEN@host:port
UPSTASH_REDIS_URL=rediss://default:<token>@<endpoint>.upstash.io:6379

# Server
PORT=4000
NODE_ENV=production
TZ=Asia/Kolkata
