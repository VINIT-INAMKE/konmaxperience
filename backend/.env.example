# Database (Neon PostgreSQL)
# DATABASE_URL = pooled connection (use -pooler subdomain, for app queries)
# DIRECT_DATABASE_URL = direct connection (no pooler, for prisma migrate only)
# IMPORTANT: Do NOT add channel_binding=require — incompatible with Neon pooler
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DIRECT_DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# JWT (shared with frontend middleware — must be identical on both)
JWT_SECRET=<64-char-random-string>

# Email (MailerSend)
MAILERSEND_API_KEY=<your-api-key>
MAILERSEND_FROM_EMAIL=noreply@konma.store

# Frontend URL (CORS + email links)
FRONTEND_URL=https://konma.store

# Cloudflare R2 (Evidence Storage)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<key>
R2_SECRET_ACCESS_KEY=<secret>
R2_BUCKET_NAME=konma-evidence
R2_PUBLIC_URL=https://<bucket>.r2.dev

# Redis (Upstash — optional, notifications disabled without it)
# Get the TCP URL from https://console.upstash.com -> your database
# Format: rediss://default:TOKEN@host:port
UPSTASH_REDIS_URL=rediss://default:<token>@<endpoint>.upstash.io:6379

# Pusher (Real-time chat)
PUSHER_APP_ID=<app_id>
PUSHER_KEY=<key>
PUSHER_SECRET=<secret>
PUSHER_CLUSTER=ap2

# Customer Auth (Phase 23)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Razorpay (Phase 23)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Server
PORT=4000
NODE_ENV=production
TZ=Asia/Kolkata
