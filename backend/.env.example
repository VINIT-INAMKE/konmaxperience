# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/konmaxperience

# JWT
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Email (MailerSend)
MAILERSEND_API_KEY=your-mailersend-api-key
MAILERSEND_FROM_EMAIL=noreply@konmaxperience.com

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:3000

# Cloudflare R2 (Evidence Storage)
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=konma-evidence
R2_PUBLIC_URL=https://your-bucket-public-url.r2.dev

# Redis (Upstash — for BullMQ notification queue)
# Get these from https://console.upstash.com → your database → Details tab
UPSTASH_REDIS_ENDPOINT=
UPSTASH_REDIS_PORT=6379
UPSTASH_REDIS_TOKEN=

# Server
PORT=4000
